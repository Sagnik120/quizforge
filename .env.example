# ─── Backend ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/quizforge
# For local SQLite dev (comment out DATABASE_URL above and use this):
# DATABASE_URL=sqlite+aiosqlite:///./quizforge.db

SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=QuizForge
