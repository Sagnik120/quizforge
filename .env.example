# ─── Backend ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/quizforge
# For local SQLite dev (comment out DATABASE_URL above and use this):
# DATABASE_URL=sqlite+aiosqlite:///./quizforge.db

SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=QuizForge

# ─── PrepDuo ───────────────────────────────────────────
# People who get a one-click button on the landing page
# USERS=["Sagnik","Shrusti"]
# Optional shared passcode asked on the landing page (recommended once deployed)
# APP_PASSCODE=
# Hosted Postgres (Neon). Use the direct connection string, not the "-pooler" one.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# BACKEND_CORS_ORIGINS=["https://your-app.vercel.app"]
